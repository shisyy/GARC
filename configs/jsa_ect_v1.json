  "forbidden": ["source label open", "source label hash", "source score", "training", "Box", "sealed18/9/9", "B_test", "Full22", "remote execution during implementation"],
  "model": {
    "rank_transform": "own-domain train empirical mid-CDF u; held uses frozen train ECDF",
    "rank_quadratic": "q0=6u^2-6u+1, positive-QR residualized against [1,z_centered], divided by positive infinity norm",
    "pooled_mean": "one OLS with domain intercept/raw-z slope blocks and one shared q column; every object weight is exactly one",
    "shared_axis": "H=sum q(rrT-C_domain)/sum q^2; G=sym(H@H); unique top eigenvector with largest-absolute-coordinate-positive sign",
    "axis_rank": 1,
    "theta": "sum(q*c)/sqrt(sum(q^2)*sum(c^2)); fail outside [-1,1] beyond numeric tolerance; never clamp",
    "energy_contrast": "c_i=(a_i^2/sigma_parallel_domain^2)-(||b_i||^2/((D-1)*sigma_perpendicular_domain^2)), where a_i=v^T r_i and b_i=r_i-a_i*v",
    "scales": "sp_i^2=sigma_parallel_domain^2*exp(theta*q_i)/N_i and so_i^2=sigma_perpendicular_domain^2/N_i, N_i=(sigma_parallel_domain^2*exp(theta*q_i)+(D-1)*sigma_perpendicular_domain^2)/(sigma_parallel_domain^2+(D-1)*sigma_perpendicular_domain^2)",
    "identifiability": "each domain requires sigma_parallel^2 and sigma_perpendicular^2 each strictly greater than rank_relative_tolerance times max(total first-pass residual energy sigma_parallel^2+(D-1)*sigma_perpendicular^2, total centered-field energy); no clamp; exact affine, rank-one, zero-perpendicular, and width-one fields fail closed",
    "post_scale_fwl": "after freezing v,sp,so, refit unweighted pooled fixed-effect design X separately to y_parallel/sp and y_perp/so; project perpendicular coefficients off v; E=(y_parallel/sp-X*beta_parallel)*v+(y_perp/so-X*beta_perp)",
    "exact_reconstruction": "y=sp*(X*beta_parallel+E_parallel)*v+so*(X*beta_perp+E_perp)",
    "transport": "domain sorted opaque-ID shift-one train and balanced round-robin held; preserve recipient within-object offsets",
    "mechanical_displacement": "recipient final coordinate is appended bit-for-bit and never transported",
    "candidate_search": false
  },
  "numerics": {
