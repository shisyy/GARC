  "model": {
    "rank_transform": "per-domain train empirical mid-CDF mapped to [-1,1]; held uses train ECDF and clips only to [0.5/n,1-0.5/n]",
    "location_basis": ["1", "x", "(3*x^2-1)/2"],
    "location_solver": "float64 reduced QR; columns sign-flipped so R diagonal is positive",
    "scale_target": "log(RMS(location residual across field dimensions)+epsilon)",
    "scale_basis": ["1", "x"],
    "epsilon": "max(1e-12,1e-6*RMS(centered object means))",
    "scale_output": "exp(linear log scale), with no clipping",
    "standardized_residual": "E=(object_mean-location(x))/scale(x)",
    "transport": "per-domain sorted opaque-ID shift-one for train; sorted-held to sorted-train balanced round-robin for held; preserve recipient within-object offsets",
    "mechanical_displacement": "recipient final displacement coordinate is bit-identical and is never transported",
    "degree_or_candidate_search": false
  },
  "numerics": {
    "dtype": "float64",
    "rank_relative_tolerance": 1e-12,
    "condition_max": 1000000.0,
    "positive_r_diagonal_required": true,
    "finite_required": true,
    "scale_clipping_forbidden": true
  },
  "crossfit": {
    "folds": 5,
    "assignment": "sort by sha256('splart-rqlsot-crossfit-v1:'+opaque_object_id), balanced round-robin",
    "preprocessing": "ECDF, QR location, and QR log-scale refit only on each fold's train objects",
    "absolute_spearman_at_most": 0.35,
    "distance_correlation_at_most": 0.5
  },
  "gates": {
    "reconstruction_max_error": 1e-10,
    "orthogonality_max": 1e-10,
    "held_boundary_clipped_fraction_max": 0.25,
    "residual_energy_ratio_at_least": 0.05,
    "shuffle_rms_over_original_sd_at_least": 0.1,
    "shuffled_norm_p99_ratio_at_most": 1.25,
    "train_coverage": 1.0,
    "held_coverage": 1.0,
    "train_self_rate": 0.0,
    "train_donor_marginal_exact": true,
    "held_effective_donors_per_object": 1.0,
    "repeat_bit_identical": true,
    "row_order_invariant": true,
    "all_four_domain_null_cells_required": true,
    "no_node89_gate_regression": true
  },
