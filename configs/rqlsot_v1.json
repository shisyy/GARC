{
  "schema": "splart-rqlsot-label-free-preregister/v1",
  "node": "8.10",
  "hypothesis": "rank-quadratic location plus linear log-radial scale removes nonlinear conditional dependence without relaxing node 8.9 gates",
  "created_before_remote_feasibility": true,
