{
  "schema": "splart-rza-acwt-label-free-preregister/v1",
  "node": "8.11",
  "hypothesis": "raw-z-anchored location and one anisotropic conditional covariance direction remove the remaining label-free dependence without relaxing RQ-LSOT gates",
  "created_before_any_remote_result": true,
  "predecessor_commit": "f7bdfa1a4a112c96c0067db19ead8c1fe1716a2e",
  "predecessor_config_sha256": "e3d6c1b3d59e2fd4c155fcff7e818cce0af95343da81c9d2f01bb2990c0a5acc",
  "allowed_inputs": "frozen feature caches, opaque source sidecars, renderer logs, and DINO checkpoint hash only",
  "forbidden": ["source label open", "source label hash", "source score", "training", "Box", "sealed18/9/9", "B_test", "Full22", "remote execution during implementation"],
  "model": {
    "rank_transform": "per-domain train empirical mid-CDF x in [-1,1]; held uses train ECDF and clips only to [0.5/n,1-0.5/n]",
    "raw_z_center": "subtract the domain fold-train arithmetic mean; held uses that same mean",
    "rank_quadratic": "P2(x)=(3*x^2-1)/2",
    "location_basis": ["1", "z_centered", "q_perp"],
    "q_perp": "project P2(train x) off positive-QR span [1,z_centered], divide by train RMS; held applies the frozen projection and RMS",
    "location_solver": "float64 reduced QR with positive diagonal",
    "radial_scale": "s0=exp(OLS([1,x],log(RMS(location residual)+epsilon0)))",
    "covariance": "g=R/s0; C0=mean(ggT); A1=mean(x*(ggT-C0)); A2=mean(P2(x)*(ggT-C0)); H=A1@A1+A2@A2",
    "axis": "top eigenvector of symmetric H; sign makes its largest-absolute coordinate positive, lowest index breaks ties",
    "axis_rank": 1,
    "eigengap": "lambda_max-lambda_second must exceed 100*eps_float64*operator_norm(H)",
    "block_scale_basis": ["1", "x", "P2(x)"],
    "block_scales": "separate positive exp-OLS fits to log(|dot(g,v)|+epsilon_g) and log(RMS over the D-1 orthogonal coordinates+epsilon_g); no clipping",
    "epsilon0": "max(1e-12,1e-6*RMS(centered object means))",
    "epsilon_g": "max(1e-12,1e-6*RMS(g))",
    "standardized_residual": "E=(dot(g,v)/s_parallel)*v+(g-dot(g,v)*v)/s_perp",
    "transport": "per-domain sorted opaque-ID shift-one for train; sorted-held to sorted-train balanced round-robin for held; preserve recipient within-object offsets",
    "mechanical_displacement": "recipient final displacement coordinate is appended bit-for-bit and is never transported",
    "row_identity": "domain + ':' + stable gauge_id/row_id/joint_id:order",
    "candidate_search": false
  },
  "numerics": {
    "dtype": "float64",
    "rank_relative_tolerance": 1e-12,
    "condition_max": 1000000.0,
    "eigengap_multiplier": 100.0,
    "positive_r_diagonal_required": true,
    "finite_required": true,
    "scale_clipping_forbidden": true
  },
  "crossfit": {
    "folds": 5,
    "assignment": "sort by sha256('splart-rza-acwt-crossfit-v1:'+domain+':'+opaque_object_id), balanced round-robin within each domain",
    "preprocessing": "every fold refits one joint-domain PCA and mechanical scaling; then each domain refits raw-z center, ECDF, q projection, location, s0, covariance axis, and both block scales",
    "semantic_oof_coordinates": "map fold-local PCA E back to raw DINO coordinates",
    "mechanical_oof_coordinates": "zero-fill fold-dropped raw geometry columns; displacement is excluded",
    "absolute_spearman_at_most": 0.35,
    "distance_correlation_at_most": 0.5
  },
  "gates": {
    "reconstruction_max_error": 1e-10,
    "orthogonality_max": 1e-10,
    "raw_z_correlation_max": 1e-10,
    "held_boundary_clipped_fraction_max": 0.25,
    "residual_energy_ratio_at_least": 0.05,
    "shuffle_rms_over_original_sd_at_least": 0.1,
    "shuffled_norm_p99_ratio_at_most": 1.25,
    "train_coverage": 1.0,
    "held_coverage": 1.0,
    "train_self_rate": 0.0,
    "train_donor_marginal_exact": true,
    "held_effective_donors_per_object": 1.0,
    "recipient_u_max_error": 1e-12,
    "repeat_bit_identical": true,
    "row_order_invariant": true,
    "independent_double_recompute": true,
    "all_four_domain_null_cells_required": true,
    "no_node810_gate_regression": true
  },
